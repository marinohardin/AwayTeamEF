<?xml version="1.0" encoding="utf-8"?>
<!--
  AwayTeamEF for Meta Quest (arm64-v8a, OpenXR + Vulkan): android/make-apk.sh VR=1.
  The flat phone/tablet APK uses AndroidManifest.xml; this one differs only in the VR parts:
  its own package (so both can be installed, each with its own data folder), the VR
  launcher category, the OpenXR runtime permissions and queries, the supported headsets,
  head tracking, landscape and no system UI. make-apk.sh fills in versionCode/versionName
  and the SDK levels with aapt2's - -version-code etc.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.awayteamef.quest"
    android:installLocation="auto">

    <!-- the renderer is Vulkan only (renderervk); Vulkan 1.0.3 -->
    <uses-feature android:name="android.hardware.vulkan.version"
        android:version="0x400003" android:required="true" />
    <!-- a headset with 6DoF head tracking -->
    <uses-feature android:name="android.hardware.vr.headtracking"
        android:version="1" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <!-- Holomatch and co-op need sockets -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- the OpenXR loader talks to the installed runtime (Meta's, on the Quest) -->
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />

    <!-- package visibility (Android 11+) for the loader's runtime and API layer lookup -->
    <queries>
        <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker" />
        <intent>
            <action android:name="org.khronos.openxr.OpenXRRuntimeService" />
        </intent>
        <intent>
            <action android:name="org.khronos.openxr.OpenXRApiLayerService" />
        </intent>
    </queries>

    <!-- game data and configs live in the app's own OBB folder: no storage permission -->
    <application android:label="AwayTeamEF VR"
        android:allowBackup="false"
        android:hasCode="true"
        android:extractNativeLibs="true"
        android:hardwareAccelerated="true"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

        <!-- the start screen: a plain Android activity, a flat panel in the headset, with four buttons
             that launch QuestActivity (below) with the arguments for that mode. It is the app's
             one launcher entry. -->
        <activity android:name="org.awayteamef.app.StartActivity"
            android:label="AwayTeamEF VR"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Quest 2 and later -->
        <meta-data android:name="com.oculus.supportedDevices"
            android:value="quest2|questpro|quest3|quest3s" />

        <!-- the game runs in a process of its own: the engine runs once per process and ends it
             at quit; the start screen stays in the main one, so a Quit from the game's menus
             comes back to it (QuestActivity.quitToLauncher, android/jni/quest_jni.c) -->
        <activity android:name="org.awayteamef.app.QuestActivity"
            android:label="AwayTeamEF VR"
            android:process=":game"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:resizeableActivity="false"
            android:excludeFromRecents="false"
            android:configChanges="density|layoutDirection|locale|fontScale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="true">
            <!-- the system menu can show over the app while it keeps running -->
            <meta-data android:name="com.oculus.vr.focusaware" android:value="true" />
            <!-- the game itself, started by StartActivity (or "adb shell am start -n
                 org.awayteamef.quest/org.awayteamef.app.QuestActivity -e args ..."): the VR category
                 and no launcher entry of its own -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.oculus.intent.category.VR" />
            </intent-filter>
        </activity>
    </application>
</manifest>
